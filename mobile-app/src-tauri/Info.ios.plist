<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets a development build load the web app from the Mac's dev server
	     (http://localhost:3000). Production loads https://app.sealme.net. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Only standard HTTPS, so no export compliance questions on upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Recording meetings (plugins/recorder). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SealMe records your meetings so it can write up the notes.</string>
	<!-- Keeps a recording going with the screen locked or another app open. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
