{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "Capability for the floating companion window",
  "windows": ["companion"],
  "remote": {
    "urls": ["https://app.sealme.net/companion*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-toggle-companion-rail",
    "allow-select-companion-view",
    "allow-is-local-capturing",
    "allow-discard-local-capture",
    "allow-stop-local-capture-and-upload"
  ]
}
