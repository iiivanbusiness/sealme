{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "accord-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "accord-prod-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTH_TRUST_HOST=true",
        "npx",
        "next",
        "start",
        "-p",
        "3000"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}