# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite db
/prisma/dev.db
/prisma/dev.db-journal

/dev.db
/dev.db-journal

# Personal notes, docs, lead lists and scratch files in the project root (not code)
/*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
/*.csv
/*.xlsx
/*.pdf
/*.txt
/scratch-*.html
/demo-data-ids.json
